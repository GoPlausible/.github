# Copy to .env and fill in.
# Base64-encoded 64-byte Algorand key (32-byte seed + 32-byte public key)
# for a TestNet buyer account holding USDC (ASA 10458941)
AVM_PRIVATE_KEY=base64-encoded-64-byte-key

# The paid endpoint to call (any of the server examples)
RESOURCE_URL=http://localhost:4021/my-api
